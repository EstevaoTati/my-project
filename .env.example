# ============================================================
# Mwinda Digital — AI Agents Agency · Variables d'environnement
# Copiez ce fichier vers .env.local (dev) ou configurez sur Vercel.
# ============================================================

# --- Base de données (PostgreSQL, ex: Supabase / Neon / Vercel Postgres) ---
# Obligatoire pour enregistrer les leads du formulaire de contact.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=""

# --- API Anthropic (moteur conversationnel des agents / sandbox) ---
# Sans cette clé, l'espace de test /sandbox fonctionne en mode simulation (mock).
# Obtenir une clé: https://platform.claude.com/
ANTHROPIC_API_KEY=""

# --- Resend (emails transactionnels) ---
# Sans cette clé, l'envoi d'email de notification de lead est désactivé (log seulement).
# Obtenir une clé: https://resend.com/
RESEND_API_KEY=""

# Adresse qui reçoit les notifications de nouveaux leads
LEAD_NOTIFICATION_EMAIL="estevaomacumba@gmail.com"

# Adresse expéditrice (doit être un domaine vérifié sur Resend)
LEAD_FROM_EMAIL="Mwinda Digital <notifications@mwinda.digital>"

# --- Moteur d'agent (Phase 2) ---
# Secret partagé exigé par les endpoints /api/webhooks/inbound et /api/drafts/:id
# (header: x-mwinda-webhook-secret). Sans cette valeur, ces endpoints sont désactivés.
# Générer par ex. avec : openssl rand -hex 32
WEBHOOK_SECRET=""

# --- Auth dashboard & admin (Phases 3-4) ---
# Secret de signature des sessions par cookie (HMAC). Obligatoire pour le
# dashboard client et le back-office admin. Générer : openssl rand -hex 32
AUTH_SECRET=""

# Code d'accès du back-office admin (Estevao). Générer : openssl rand -hex 24
ADMIN_ACCESS_TOKEN=""

# --- Stripe (Phase 4, facturation) ---
# Sans STRIPE_SECRET_KEY, les routes de facturation renvoient 503 proprement.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs des 3 paliers (créés dans le dashboard Stripe)
STRIPE_PRICE_ESSENTIAL=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_FIRM=""

# --- Cron rapports mensuels (Phase 3) ---
# Vercel Cron envoie Authorization: Bearer $CRON_SECRET. Générer : openssl rand -hex 32
CRON_SECRET=""

# --- Site ---
# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://mwinda.digital"
