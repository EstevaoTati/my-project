# Copy to .env and fill in. Never commit the real values.

# Resend API key. Without it the service prints e-mails instead of sending them.
RESEND_API_KEY=

# Must be a domain verified in Resend, or delivery is refused.
OTP_MAIL_FROM="242Konnect <verification@242konnect.net>"

# Separates our code hashes from a generic rainbow table. Any long random string.
OTP_PEPPER=

# Comma-separated origins allowed to call the API. Narrow this in production.
CORS_ORIGINS=*

# --- Mobile Money -----------------------------------------------------------
# Leave an operator's variables blank and it is refused with a clear message
# rather than faked. GET /health reports which ones are live.

# MTN MoMo Collections — https://momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Airtel Money Collections — https://developers.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF
