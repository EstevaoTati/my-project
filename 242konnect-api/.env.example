# Copy to .env and fill in. Never commit the real values.

# Resend API key. Without it the service prints e-mails instead of sending them.
RESEND_API_KEY=

# Must be a domain verified in Resend, or delivery is refused.
OTP_MAIL_FROM="242Konnect <verification@242konnect.net>"

# Separates our code hashes from a generic rainbow table. Any long random string.
OTP_PEPPER=

# Comma-separated origins allowed to call the API. Narrow this in production.
CORS_ORIGINS=*
