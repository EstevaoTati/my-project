# 242Konnect — build configuration.
#
# Expo bakes every EXPO_PUBLIC_* variable into the bundle at build time, and
# reads this file automatically. Without it `supabaseConfigured` is false, the
# app has no verification service at all, and sign-up refuses before it even
# tries with:
#
#   "La vérification par e-mail n'est pas configurée sur cette version de
#    démonstration. Aucun code ne peut être envoyé, donc la création de compte
#    est indisponible ici."
#
# That is exactly what shipped: every package built before this file existed
# carried no Supabase, so no amount of fixing the mailer would have helped.
# `tools/build-web.js` now refuses to finish a build whose bundle has no
# provider in it, so it cannot happen silently again.
#
# ---------------------------------------------------------------------------
# On committing the key: this is the **publishable** (anon) key, and it is
# designed to ship inside a client. It authorises only what row-level security
# allows — the policy on public.profiles is `auth.uid() = id`, so it reaches
# your own row and nobody else's, and public.user_pin has RLS on with no
# policies at all, so it reaches that table not at all.
#
# What must NEVER be here: the service_role key, or a mail provider key
# (Resend, SendGrid). Either of those in a bundle can be unzipped out of an APK
# and used directly. The service role bypasses RLS entirely; a mail key lets
# anyone send e-mail as 242Konnect. Those belong in the Edge Function's
# environment, which is where the PIN function reads its service role from.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://abdmdtftnuyjzkdkcwiq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_K8moeXuEwhPiUWFMwCli0g_XHeW4H8L

# Match this to Auth → Email OTP Expiration in the dashboard. GoTrue does not
# report the lifetime in its response, so the screen reads it from here to tell
# someone how long their code is good for.
EXPO_PUBLIC_SUPABASE_OTP_TTL=3600
